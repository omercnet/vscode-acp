{
  "name": "vscode-acp",
  "displayName": "VSCode ACP",
  "description": "AI coding agents in VS Code via Agent Client Protocol (ACP). Chat with Claude, OpenCode, and other ACP-compatible agents directly in your editor.",
  "version": "1.6.0",
  "publisher": "omercnet",
  "license": "MIT",
  "icon": "assets/icon.png",
  "preview": true,
  "pricing": "Free",
  "qna": "marketplace",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omercnet/vscode-acp"
  },
  "bugs": {
    "url": "https://github.com/omercnet/vscode-acp/issues"
  },
  "homepage": "https://github.com/omercnet/vscode-acp#readme",
  "engines": {
    "vscode": "^1.74.0",
    "node": "^22"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "claude",
    "opencode",
    "acp",
    "agent",
    "chat",
    "copilot",
    "coding assistant",
    "llm"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Workspace-defined agent executable paths and MCP server configuration are disabled until the workspace is trusted.",
      "restrictedConfigurations": [
        "vscode-acp.agentPaths",
        "vscode-acp.mcpServers"
      ]
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-acp.startChat",
        "title": "Start Chat",
        "category": "ACP",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "vscode-acp.addSelectionToChat",
        "title": "Add Selection to Chat",
        "category": "ACP",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "vscode-acp.newChat",
        "title": "New Chat",
        "category": "ACP",
        "icon": "$(add)"
      },
      {
        "command": "vscode-acp.clearChat",
        "title": "Clear Chat",
        "category": "ACP",
        "icon": "$(clear-all)"
      },
      {
        "command": "vscode-acp.loadSession",
        "title": "Load Session",
        "category": "ACP",
        "icon": "$(history)"
      },
      {
        "command": "vscode-acp.deleteSession",
        "title": "Delete Session",
        "category": "ACP",
        "icon": "$(trash)"
      },
      {
        "command": "vscode-acp.sessions.refresh",
        "title": "Refresh Sessions",
        "category": "ACP",
        "icon": "$(refresh)"
      },
      {
        "command": "vscode-acp.sessions.refreshAgent",
        "title": "Retry Session Discovery",
        "category": "ACP",
        "icon": "$(refresh)"
      },
      {
        "command": "vscode-acp.sessions.loadMore",
        "title": "Load More Sessions",
        "category": "ACP"
      },
      {
        "command": "vscode-acp.sessions.open",
        "title": "Open Session",
        "category": "ACP"
      },
      {
        "command": "vscode-acp.sessions.load",
        "title": "Load Session with History",
        "category": "ACP",
        "icon": "$(history)"
      },
      {
        "command": "vscode-acp.sessions.resume",
        "title": "Resume Session without History",
        "category": "ACP",
        "icon": "$(debug-continue)"
      },
      {
        "command": "vscode-acp.sessions.authenticate",
        "title": "Sign In to Agent",
        "category": "ACP",
        "icon": "$(account)"
      },
      {
        "command": "vscode-acp.showDiagnostics",
        "title": "Show Diagnostics",
        "category": "ACP",
        "icon": "$(output)"
      },
      {
        "command": "vscode-acp.restartAgent",
        "title": "Restart Agent",
        "category": "ACP",
        "icon": "$(debug-restart)"
      },
      {
        "command": "vscode-acp.disconnectAgent",
        "title": "Disconnect Agent",
        "category": "ACP",
        "icon": "$(debug-disconnect)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscode-acp",
          "title": "VSCode ACP",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "vscode-acp": [
        {
          "type": "webview",
          "id": "vscode-acp.chatView",
          "name": "Chat",
          "icon": "$(comment-discussion)",
          "contextualTitle": "ACP Chat"
        },
        {
          "id": "vscode-acp.sessionsView",
          "name": "Agent Sessions",
          "icon": "$(history)",
          "contextualTitle": "ACP Agent Sessions"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vscode-acp.newChat",
          "when": "view == vscode-acp.chatView",
          "group": "navigation@1"
        },
        {
          "command": "vscode-acp.loadSession",
          "when": "view == vscode-acp.chatView",
          "group": "navigation@2"
        },
        {
          "command": "vscode-acp.deleteSession",
          "when": "view == vscode-acp.chatView",
          "group": "navigation@3"
        },
        {
          "command": "vscode-acp.clearChat",
          "when": "view == vscode-acp.chatView",
          "group": "navigation@4"
        },
        {
          "command": "vscode-acp.restartAgent",
          "when": "view == vscode-acp.chatView",
          "group": "navigation@5"
        },
        {
          "command": "vscode-acp.disconnectAgent",
          "when": "view == vscode-acp.chatView",
          "group": "navigation@6"
        },
        {
          "command": "vscode-acp.showDiagnostics",
          "when": "view == vscode-acp.chatView",
          "group": "navigation@7"
        },
        {
          "command": "vscode-acp.sessions.refresh",
          "when": "view == vscode-acp.sessionsView",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "vscode-acp.sessions.load",
          "when": "view == vscode-acp.sessionsView && viewItem =~ /vscode-acp\\.session\\.(load|load-resume)/",
          "group": "inline@1"
        },
        {
          "command": "vscode-acp.sessions.resume",
          "when": "view == vscode-acp.sessionsView && viewItem =~ /vscode-acp\\.session\\.(resume|load-resume)/",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "command": "vscode-acp.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "1_modification@90"
        }
      ],
      "commandPalette": [
        {
          "command": "vscode-acp.startChat",
          "when": "true"
        },
        {
          "command": "vscode-acp.addSelectionToChat",
          "when": "editorHasSelection"
        },
        {
          "command": "vscode-acp.newChat",
          "when": "true"
        },
        {
          "command": "vscode-acp.clearChat",
          "when": "true"
        },
        {
          "command": "vscode-acp.loadSession",
          "when": "true"
        },
        {
          "command": "vscode-acp.deleteSession",
          "when": "true"
        },
        {
          "command": "vscode-acp.sessions.refreshAgent",
          "when": "false"
        },
        {
          "command": "vscode-acp.sessions.loadMore",
          "when": "false"
        },
        {
          "command": "vscode-acp.sessions.open",
          "when": "false"
        },
        {
          "command": "vscode-acp.sessions.load",
          "when": "false"
        },
        {
          "command": "vscode-acp.sessions.resume",
          "when": "false"
        },
        {
          "command": "vscode-acp.sessions.authenticate",
          "when": "false"
        },
        {
          "command": "vscode-acp.showDiagnostics",
          "when": "true"
        },
        {
          "command": "vscode-acp.restartAgent",
          "when": "true"
        },
        {
          "command": "vscode-acp.disconnectAgent",
          "when": "true"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vscode-acp.addSelectionToChat",
        "key": "ctrl+alt+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "VSCode ACP",
      "properties": {
        "vscode-acp.agentPaths": {
          "type": "object",
          "scope": "machine-overridable",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Absolute executable paths keyed by agent ID. User-defined paths remain available in Restricted Mode; workspace-defined paths require Workspace Trust."
        },
        "vscode-acp.mcpServers": {
          "type": "array",
          "scope": "resource",
          "default": [],
          "markdownDescription": "MCP servers connected when ACP sessions are created or loaded. User settings have the lowest precedence, followed by workspace and workspace-folder settings; a trusted `.vscode/mcp.json` has highest precedence by case-insensitive server name. Use `${env:NAME}` only in environment variable and HTTP header values; references are resolved when a session starts.",
          "items": {
            "oneOf": [
              {
                "title": "Stdio MCP server",
                "type": "object",
                "required": [
                  "name",
                  "command"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "stdio"
                    ],
                    "default": "stdio"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Absolute path to the MCP server executable."
                  },
                  "args": {
                    "type": "array",
                    "default": [],
                    "items": {
                      "type": "string"
                    }
                  },
                  "env": {
                    "type": "array",
                    "default": [],
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "value"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              {
                "title": "HTTP MCP server",
                "type": "object",
                "required": [
                  "type",
                  "name",
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "http"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://",
                    "description": "HTTPS URL for the MCP server."
                  },
                  "headers": {
                    "type": "array",
                    "default": [],
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "value"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              {
                "title": "SSE MCP server",
                "type": "object",
                "required": [
                  "type",
                  "name",
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "sse"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://",
                    "description": "HTTPS URL for the deprecated SSE transport."
                  },
                  "headers": {
                    "type": "array",
                    "default": [],
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "value"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "vscode-acp.diagnostics.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Record bounded, secret-safe ACP traffic metadata in the dedicated ACP Diagnostics output channel. Protocol bodies, credentials, file contents, terminal output, and agent stderr are never recorded."
        },
        "vscode-acp.sessions.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Save new and updated ACP sessions in this workspace history."
        },
        "vscode-acp.sessions.maxHistory": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 200,
          "description": "Maximum number of ACP sessions stored per workspace."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "test": "vscode-test",
    "precoverage": "npm run compile-tests && npm run compile",
    "coverage": "vscode-test --coverage --coverage-output coverage --coverage-reporter lcov --coverage-reporter text",
    "coverage:html": "vscode-test --coverage --coverage-reporter html",
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md}\"",
    "prepare": "husky",
    "screenshot": "npx tsx scripts/screenshot.ts",
    "smoke:agent-resolution": "tsx scripts/agent-resolution-smoke.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@playwright/test": "^1.57.0",
    "@types/jsdom": "^27.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "npm-run-all": "^4.1.5",
    "ovsx": "1.1.1",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "dompurify": "^3.4.15",
    "jsonc-parser": "^3.3.1",
    "marked": "^17.0.1",
    "vscode-jsonrpc": "^8.2.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "serialize-javascript": "7.1.0"
  }
}
